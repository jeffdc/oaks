<%!-- Skip to main content link for keyboard/screen reader users --%>
<a href="#main-content" class="skip-link">Skip to main content</a>

<header
  class="sticky top-0 z-40 dark-bg"
  style="background: linear-gradient(135deg, #6b9072 0%, #83a98a 100%); box-shadow: var(--shadow-lg);"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
    <div class="flex flex-wrap items-center gap-4">
      <%!-- Logo and title --%>
      <.link
        navigate={~p"/"}
        class="flex items-center gap-3 hover:opacity-90 transition-opacity"
        style="text-decoration: none;"
        aria-label="Oak Compendium home"
      >
        <img
          src={~p"/images/oakcompendium-192.png"}
          alt=""
          class="w-14 h-14"
          aria-hidden="true"
        />
        <span
          class="text-xl font-bold text-white tracking-wide"
          style="font-family: var(--font-serif); letter-spacing: 0.01em;"
        >
          Oak Compendium
        </span>
      </.link>

      <%!-- Search --%>
      <div class="flex-1 max-w-md ml-auto" role="search" aria-label="Search species">
        <form action={~p"/search"} method="get" class="relative">
          <label for="header-search" class="sr-only">Search species</label>
          <input
            type="search"
            id="header-search"
            name="q"
            placeholder="Search by name, author, synonym, or location..."
            class="header-search-input w-full pl-4 pr-4 py-3 text-base rounded-lg transition-all duration-200 focus:outline-none"
            autocomplete="off"
            spellcheck="false"
          />
        </form>
      </div>

      <%!-- Navigation --%>
      <nav class="flex items-center gap-1" aria-label="Main navigation">
        <.link
          :if={assigns[:authenticated]}
          navigate={~p"/species/new"}
          class="add-species-btn"
          title="Add new species"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" />
          </svg>
          <span class="add-species-text">Add Species</span>
        </.link>
        <.link navigate={~p"/articles"} class={nav_class(assigns[:current_path], "/articles")}>
          Articles
        </.link>
        <.link navigate={~p"/sources"} class={nav_class(assigns[:current_path], "/sources")}>
          Sources
        </.link>
        <.link navigate={~p"/about"} class={nav_class(assigns[:current_path], "/about")}>
          About
        </.link>
        <.link
          navigate={~p"/settings"}
          class={nav_icon_class(assigns[:current_path], "/settings")}
          title="Settings"
          aria-label="Settings"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
            class="size-5"
          >
            <path
              fill-rule="evenodd"
              d="M8.34 1.804A1 1 0 019.32 1h1.36a1 1 0 01.98.804l.295 1.473c.497.144.971.342 1.416.587l1.25-.834a1 1 0 011.262.125l.962.962a1 1 0 01.125 1.262l-.834 1.25c.245.445.443.919.587 1.416l1.473.295a1 1 0 01.804.98v1.36a1 1 0 01-.804.98l-1.473.295a6.95 6.95 0 01-.587 1.416l.834 1.25a1 1 0 01-.125 1.262l-.962.962a1 1 0 01-1.262.125l-1.25-.834a6.953 6.953 0 01-1.416.587l-.295 1.473a1 1 0 01-.98.804H9.32a1 1 0 01-.98-.804l-.295-1.473a6.957 6.957 0 01-1.416-.587l-1.25.834a1 1 0 01-1.262-.125l-.962-.962a1 1 0 01-.125-1.262l.834-1.25a6.957 6.957 0 01-.587-1.416l-1.473-.295A1 1 0 011 10.68V9.32a1 1 0 01.804-.98l1.473-.295c.144-.497.342-.971.587-1.416l-.834-1.25a1 1 0 01.125-1.262l.962-.962A1 1 0 015.38 3.03l1.25.834a6.957 6.957 0 011.416-.587l.295-1.473zM13 10a3 3 0 11-6 0 3 3 0 016 0z"
              clip-rule="evenodd"
            />
          </svg>
        </.link>
      </nav>
    </div>
  </div>
</header>

<main
  id="main-content"
  class="flex-1 max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-12 py-10 w-full"
  tabindex="-1"
  style="outline: none;"
>
  {@inner_content}
</main>

<.flash_group flash={@flash} />
