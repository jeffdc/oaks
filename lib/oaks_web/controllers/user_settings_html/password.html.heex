<.page width="form" id="change-password-page">
  <:head>
    <.back navigate={~p"/settings"}>Back to settings</.back>
    <.header>Change password</.header>
  </:head>

  <section class="settings-section">
    <p class="settings-description">
      Changing the password logs out every other session.
    </p>
    <.form for={@form} id="password-form" action={~p"/users/settings/password"} method="put">
      <.auth_field
        field={@form[:password]}
        type="password"
        label="New password (at least 12 characters)"
        autocomplete="new-password"
        required
      />
      <.auth_field
        field={@form[:password_confirmation]}
        type="password"
        label="Confirm new password"
        autocomplete="new-password"
        required
      />
      <div class="settings-button-group">
        <.button type="submit" variant="primary">Change password</.button>
        <.button href={~p"/settings"}>Cancel</.button>
      </div>
    </.form>
  </section>
</.page>
