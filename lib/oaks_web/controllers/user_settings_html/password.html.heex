<div class="settings-container" id="change-password-page">
  <h1 class="settings-title">Change password</h1>

  <section class="card p-6">
    <p class="settings-description">
      Changing the password logs out every other session.
    </p>
    <.form for={@form} id="password-form" action={~p"/users/settings/password"} method="put">
      <.auth_field
        field={@form[:password]}
        type="password"
        label="New password (at least 12 characters)"
        autocomplete="new-password"
        required
      />
      <.auth_field
        field={@form[:password_confirmation]}
        type="password"
        label="Confirm new password"
        autocomplete="new-password"
        required
      />
      <div class="settings-button-group">
        <button type="submit" class="settings-btn settings-btn-primary">Change password</button>
        <.link href={~p"/settings"} class="settings-btn settings-btn-secondary">Cancel</.link>
      </div>
    </.form>
  </section>
</div>
