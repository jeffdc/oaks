<div class="settings-container" id="new-api-token-page">
  <h1 class="settings-title">New agent token</h1>

  <section class="card p-6">
    <p class="settings-description">
      This token for <strong>{@token.name}</strong>
      won't be shown again: click it to copy it. It grants {Enum.join(@token.scopes, " and ")} until {date(
        @token.expires_at
      )}. Agents send it as <code>Authorization: Bearer &lt;token&gt;</code>.
    </p>
    <button
      type="button"
      id="api-token-value"
      class="settings-copy-value"
      data-copy={@raw}
      title="Copy to clipboard"
    >
      <span class="settings-copy-text">{@raw}</span>
      <span class="settings-copy-status" data-copy-status aria-live="polite">Click to copy</span>
    </button>
    <div class="settings-button-group">
      <.link href={~p"/users/settings/api-tokens"} class="settings-btn settings-btn-primary">
        I've copied it
      </.link>
    </div>
  </section>
</div>
