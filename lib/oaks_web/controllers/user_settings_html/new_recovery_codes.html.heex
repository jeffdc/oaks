<.page width="form" id="new-recovery-codes-page">
  <:head>
    <.header>New recovery codes</.header>
  </:head>

  <section class="settings-section">
    <p class="settings-description">Your old recovery codes no longer work.</p>
    <.recovery_code_list codes={@codes} />
    <div class="settings-button-group">
      <.button href={~p"/settings"} variant="primary">I've saved them</.button>
    </div>
  </section>
</.page>
