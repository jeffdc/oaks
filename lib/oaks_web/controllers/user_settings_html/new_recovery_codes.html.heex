<div class="settings-container" id="new-recovery-codes-page">
  <h1 class="settings-title">New recovery codes</h1>

  <section class="card p-6">
    <p class="settings-description">Your old recovery codes no longer work.</p>
    <.recovery_code_list codes={@codes} />
    <div class="settings-button-group">
      <.link href={~p"/settings"} class="settings-btn settings-btn-primary">I've saved them</.link>
    </div>
  </section>
</div>
