<.error_page
  title="Something went wrong"
  description="The Oak Compendium hit an error showing this page."
  path={requested_path(assigns)}
>
  <.error_notice status="500" title="Something went wrong" back={back_href(assigns)}>
    The Compendium hit an error and couldn’t show this page. It wasn’t anything you did. Try again in a moment, or start again from the home page.
    <:actions>
      <.button href={~p"/"} variant="primary">Home</.button>
    </:actions>
  </.error_notice>
</.error_page>
