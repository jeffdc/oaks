<.error_page
  back={back_href(assigns)}
  status="404"
  title="Page not found"
  description="There is no page at this address on the Oak Compendium."
>
  <span :if={requested_path(assigns)}>
    There’s no page at <span class="font-frame font-semibold wrap-anywhere lining-nums tabular-nums">{requested_path(assigns)}</span>.
  </span>
  <span :if={!requested_path(assigns)}>There’s no page at this address.</span>
  The address may be mistyped, or the page may have moved. Search for the oak you were after, or browse the species list.
  <:search>
    <.search_form />
  </:search>
  <:actions>
    <.button href={~p"/list"}>Species list</.button>
    <.button href={~p"/"}>Home</.button>
  </:actions>
</.error_page>
