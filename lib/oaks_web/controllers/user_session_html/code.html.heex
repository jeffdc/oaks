<div class="settings-container" id="login-code-page">
  <.header>Log in</.header>

  <section class="settings-section">
    <p class="settings-description">
      Enter the 6-digit code from your authenticator app, or one of your recovery codes.
    </p>

    <.auth_message :if={@error == :invalid}>That code didn't work.</.auth_message>
    <.auth_message :if={@error == :too_many}>
      Too many attempts. Wait a while and try again.
    </.auth_message>

    <.form for={%{}} as={:login} id="login-code-form" action={~p"/users/log-in/code"}>
      <div class="oc-field">
        <label for="code" class="oc-label">Code</label>
        <input
          type="text"
          id="code"
          name="code"
          class="oc-input"
          autocomplete="one-time-code"
          spellcheck="false"
          required
          autofocus
        />
      </div>
      <div class="settings-button-group">
        <.button type="submit" variant="primary">Log in</.button>
      </div>
    </.form>
  </section>
</div>
