<div class="settings-container" id="login-page">
  <h1 class="settings-title">Log in</h1>

  <section class="card p-6">
    <.auth_message :if={@error == :invalid}>Invalid email or password.</.auth_message>
    <.auth_message :if={@error == :too_many}>
      Too many login attempts. Wait a while and try again.
    </.auth_message>

    <.form for={@form} id="login-form" action={~p"/users/log-in"}>
      <.auth_field
        field={@form[:email]}
        type="email"
        label="Email"
        autocomplete="username"
        spellcheck="false"
        required
        autofocus
      />
      <.auth_field
        field={@form[:password]}
        type="password"
        label="Password"
        autocomplete="current-password"
        required
      />
      <div class="settings-button-group">
        <button type="submit" class="settings-btn settings-btn-primary">Continue</button>
      </div>
    </.form>
  </section>

  <section :if={@dev_login} class="card p-6" style="margin-top: 1.5rem;" id="dev-login">
    <p class="settings-description">
      Local development: log in as the dev user, with no password or code.
    </p>
    <%!-- A plain path, not ~p: the route doesn't exist in a production build. --%>
    <.form for={%{}} action="/dev/log-in">
      <button type="submit" class="settings-btn settings-btn-secondary">
        Log in as dev user
      </button>
    </.form>
  </section>
</div>
