<div class="settings-container" id="setup-done-page">
  <.header>Setup complete</.header>

  <section class="settings-section">
    <p class="settings-description">You're logged in.</p>
    <.recovery_code_list codes={@codes} />
    <div class="settings-button-group">
      <.button href={~p"/"} variant="primary">I've saved them</.button>
    </div>
  </section>
</div>
