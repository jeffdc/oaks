<.page width="form" id="setup-page">
  <:head>
    <.header>Set up login</.header>
  </:head>

  <section class="settings-section">
    <p class="settings-description">
      Setting up login for <strong>{@user.email}</strong>. This replaces any password,
      authenticator app and recovery codes the account had, and logs out every other session.
    </p>

    <.form for={@form} id="setup-form" action={~p"/users/setup"}>
      <.section_heading class="mt-s6">1. Choose a password</.section_heading>
      <.auth_field
        field={@form[:password]}
        type="password"
        label="New password (at least 12 characters)"
        autocomplete="new-password"
        required
      />
      <.auth_field
        field={@form[:password_confirmation]}
        type="password"
        label="Confirm new password"
        autocomplete="new-password"
        required
      />

      <.section_heading class="mt-s7">2. Add the authenticator app</.section_heading>
      <p class="settings-description">
        Scan this code with an authenticator app (1Password, Google Authenticator, Authy and the like),
        or type in the key below it.
      </p>
      <div id="setup-qr" class="settings-qr">
        {@qr_svg}
      </div>
      <p id="setup-secret" class="settings-secret">
        {@display_secret}
      </p>
      <.auth_field
        field={@form[:code]}
        label="6-digit code from the app"
        autocomplete="one-time-code"
        inputmode="numeric"
        spellcheck="false"
        required
      />

      <div class="settings-button-group">
        <.button type="submit" variant="primary">Finish setup</.button>
      </div>
    </.form>
  </section>
</.page>
