.dockerignore

# Ignore git, but keep git HEAD and refs to access current commit hash if needed
.git
!.git/HEAD
!.git/refs

# Common development/test artifacts
/cover/
/doc/
/test/
/tmp/
.elixir_ls

# Mix artifacts
/_build/
/deps/
*.ez

# Generated on crash by the VM
erl_crash.dump

# Static artifacts - fetched and built inside the Docker image
/assets/node_modules/
/priv/static/assets/
/priv/static/cache_manifest.json

# V1 directories (frozen, not needed in Docker build)
/api/
/web/
/cli/
/ios/

# Python scraper (runs independently)
/scrapers/
/venv/
__pycache__
*.pyc

# Beads issue tracking
.beads/

# IDE
.idea/
.vscode/
*.swp

# Database files (not part of the build)
*.db
*.db-shm
*.db-wal

# Other
/feedback/
/openspec/
